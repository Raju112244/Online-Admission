<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Create student account | Raj University</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="assets/app.css"><link rel="stylesheet" href="assets/account.css"></head>
<body class="account-page"><header class="account-header"><a class="brand" href="index.jsp"><span class="brand-mark">R</span><span>raj<span class="brand-muted">university</span></span></a><a href="student.jsp" class="account-back">Already have an account? <b>Sign in</b></a></header><main class="account-layout"><section class="account-intro"><span class="eyebrow">START YOUR RAJ JOURNEY</span><h1>Make room for<br><em>what's next.</em></h1><p>Join a community built around curiosity, opportunity, and the confidence to make an impact.</p><div class="account-perks"><span>✓ Personalized student portal</span><span>✓ Attendance and results tracking</span><span>✓ Course and campus updates</span></div></section><section class="account-card"><div class="card-heading"><span class="eyebrow">STUDENT ACCOUNT</span><span class="step-label">STEP 1 OF 1</span></div><h2>Create your account</h2><p class="account-copy">Your email and password will be used for every future login.</p><% if (request.getAttribute("error") != null) { %><div class="form-error"><%= request.getAttribute("error") %></div><% } %><form action="signup" method="post" onsubmit="return checkPasswords()"><div class="form-grid"><div><label for="first-name">First name</label><input id="first-name" name="First_Name" required></div><div><label for="last-name">Last name</label><input id="last-name" name="Last_Name" required></div></div><label for="email">University email</label><input id="email" type="email" name="Email_Id" placeholder="you@example.com" required><div class="form-grid"><div><label for="password">Password</label><input id="password" type="password" name="password" minlength="8" placeholder="At least 8 characters" required></div><div><label for="confirm-password">Confirm password</label><input id="confirm-password" type="password" name="confirm_password" minlength="8" required></div></div><div id="password-hint" class="field-hint">Use at least 8 characters.</div><div class="form-grid"><div><label for="mobile">Mobile number</label><input id="mobile" name="Mobile_Number" inputmode="tel" required></div><div><label for="course">Course</label><select id="course" name="Course_BCA" required><option value="">Choose course</option><option>BCA</option><option>BBA</option><option>B.Sc Computer Science</option><option>BA English</option></select></div></div><label for="address">Address</label><textarea id="address" name="Address" rows="3" required></textarea><button class="primary-button full-button" type="submit">Create student account <span>→</span></button></form><small class="login-legal">By creating an account, you agree to Raj University's portal terms.</small></section></main><script>function checkPasswords(){const p=document.getElementById('password');const c=document.getElementById('confirm-password');const hint=document.getElementById('password-hint');if(p.value!==c.value){hint.textContent='Passwords do not match.';hint.classList.add('error-hint');c.focus();return false}return true}</script></body>
</html>
