<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Create parent account | Raj University</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="assets/app.css"><link rel="stylesheet" href="assets/account.css"></head>
<body class="account-page"><header class="account-header"><a class="brand" href="index.jsp"><span class="brand-mark">R</span><span>raj<span class="brand-muted">university</span></span></a><a href="parent.jsp" class="account-back">Already registered? <b>Parent sign in</b></a></header><main class="account-layout"><section class="account-intro"><span class="eyebrow">A CLEARER VIEW OF THE JOURNEY</span><h1>Support their<br><em>next step.</em></h1><p>Create a secure parent account to stay informed about the student's academic progress.</p><div class="account-perks"><span>✓ Attendance visibility</span><span>✓ Semester result access</span><span>✓ Important course updates</span></div></section><section class="account-card"><div class="card-heading"><span class="eyebrow">PARENT ACCOUNT</span><span class="step-label">STEP 1 OF 1</span></div><h2>Create parent account</h2><p class="account-copy">Use the student's university email to link your view.</p><% if (request.getAttribute("error") != null) { %><div class="form-error"><%= request.getAttribute("error") %></div><% } %><form action="ParentSignup" method="post" onsubmit="return checkPasswords()"><label for="parent-name">Your full name</label><input id="parent-name" name="parent_name" required><label for="parent-email">Your email</label><input id="parent-email" type="email" name="parent_email" placeholder="parent@example.com" required><label for="student-email">Student university email</label><input id="student-email" type="email" name="student_email" placeholder="student@example.com" required><div class="form-grid"><div><label for="password">Password</label><input id="password" type="password" name="password" minlength="8" required></div><div><label for="confirm-password">Confirm password</label><input id="confirm-password" type="password" name="confirm_password" minlength="8" required></div></div><div id="password-hint" class="field-hint">Use at least 8 characters.</div><button class="primary-button full-button" type="submit">Create parent account <span>→</span></button></form><small class="login-legal">You can use these credentials for every future parent login.</small></section></main><script>function checkPasswords(){const p=document.getElementById('password');const c=document.getElementById('confirm-password');const hint=document.getElementById('password-hint');if(p.value!==c.value){hint.textContent='Passwords do not match.';hint.classList.add('error-hint');c.focus();return false}return true}</script></body>
</html>
